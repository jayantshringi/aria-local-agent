# ==============================================================================
# aria-local-agent Environment Configuration
# ==============================================================================
# Hard rule: No user data ever leaves the owner's machines.
# Copy this file to .env and adjust as necessary. Never commit .env to git.

# Server settings
HOST=127.0.0.1
PORT=8000
ARIA_ENV=development

# Storage directory (defaults to ~/.aria if unset)
ARIA_DATA_DIR=~/.aria

# Authentication & Security
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
ARIA_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# Ollama LLM Runtime (Localhost)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Voice Settings (Local faster-whisper and Piper)
WHISPER_MODEL_SIZE=base
PIPER_VOICE_MODEL=en_US-lessac-medium

# Optional Local Search (SearXNG self-hosted, disabled by default)
SEARXNG_BASE_URL=http://127.0.0.1:8080

# Web Client CORS (Local dev & Tailscale domains)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
